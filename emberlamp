#!/bin/bash

# emberlamp - Master CLI to control all emberlamp repositories
# Usage: emberlamp <command> [options]

set -e

ORG="emberlamp"
REPOS=(
  "general"
  "react-template"
  "swe-agent"
  "gh-pin-repo"
  "config"
  "license"
  "warnings"
  "json-repo"
  "gitkeep"
  ".github"
)

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# List all repos
list_repos() {
  echo "Emberlamp Repositories:"
  for repo in "${REPOS[@]}"; do
    echo "  - $repo"
  done
}

# Clone all repos
clone_all() {
  local dir="${1:-.}"
  mkdir -p "$dir"
  for repo in "${REPOS[@]}"; do
    if [ "$repo" = ".github" ]; then
      git clone "https://github.com/$ORG/.github.git" "$dir/.github" 2>/dev/null || log_warn "Failed to clone .github"
    else
      git clone "https://github.com/$ORG/$repo.git" "$dir/$repo" 2>/dev/null || log_warn "Failed to clone $repo"
    fi
  done
  log_info "Cloned all repos to $dir"
}

# Pull all repos
pull_all() {
  for repo in "${REPOS[@]}"; do
    if [ -d "$repo" ]; then
      cd "$repo" && git pull && cd .. || log_warn "Failed to pull $repo"
    fi
  done
  log_info "Pulled all repos"
}

# Push all repos
push_all() {
  for repo in "${REPOS[@]}"; do
    if [ -d "$repo" ]; then
      cd "$repo" && git push && cd .. || log_warn "Failed to push $repo"
    fi
  done
  log_info "Pushed all repos"
}

# Create new repo
create_repo() {
  local name="$1"
  local description="${2:-New emberlamp repository}"
  gh repo create "$ORG/$name" --private --description "$description"
  log_info "Created $ORG/$name"
}

# Show status
status_all() {
  for repo in "${REPOS[@]}"; do
    if [ -d "$repo" ]; then
      echo "=== $repo ==="
      cd "$repo" && git status --short && cd ..
    else
      echo "=== $repo (not cloned) ==="
    fi
  done
}

# Main
case "$1" in
  --help|-h)
    echo "emberlamp - Master CLI for Emberlamp Organization"
    echo ""
    echo "Usage: emberlamp <command>"
    echo ""
    echo "Commands:"
    echo "  list                 List all repositories"
    echo "  clone [dir]          Clone all repos to directory"
    echo "  pull                 Pull all cloned repos"
    echo "  push                 Push all cloned repos"
    echo "  status               Show status of all repos"
    echo "  create <name> [desc] Create new repo"
    echo ""
    echo "Examples:"
    echo "  emberlamp list"
    echo "  emberlamp clone ~/emberlamp"
    echo "  emberlamp create my-new-repo"
    ;;
  list)
    list_repos
    ;;
  clone)
    clone_all "${2:-.}"
    ;;
  pull)
    pull_all
    ;;
  push)
    push_all
    ;;
  status)
    status_all
    ;;
  create)
    if [ -z "$2" ]; then
      log_error "Please specify repository name"
      exit 1
    fi
    create_repo "$2" "${3:-}"
    ;;
  *)
    log_error "Unknown command: $1"
    echo "Run 'emberlamp --help' for usage"
    exit 1
    ;;
esac